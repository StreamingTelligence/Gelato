{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gelato:v1:preflight",
  "title": "Gelato v1 local prerequisite checks",
  "description": "Device-local SDK/UI contract for pairing and capability readiness; not a WebSocket message. Only a confirmed failed required check blocks its phase. Unknown and checking do not block and must not be reported as done.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "detail", "done", "check", "phase", "required"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
      "title": { "type": "string", "minLength": 1, "maxLength": 100 },
      "detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "done": { "type": "boolean" },
      "check": {
        "type": "object",
        "required": ["state", "basis"],
        "additionalProperties": false,
        "properties": {
          "state": { "enum": ["passed", "failed", "checking", "unknown"] },
          "basis": { "enum": ["system", "probe", "inference", "none"] }
        }
      },
      "phase": { "enum": ["before-pairing", "before-control"] },
      "required": { "type": "boolean" },
      "action": { "type": "string", "minLength": 1, "maxLength": 100 },
      "button": { "type": "string", "minLength": 1, "maxLength": 100 },
      "disabled": { "type": "boolean" },
      "secondaryAction": { "type": "string", "minLength": 1, "maxLength": 100 },
      "secondaryButton": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "allOf": [
      {
        "if": { "properties": { "check": { "type": "object", "properties": { "state": { "const": "passed" } } } } },
        "then": {
          "properties": {
            "done": { "const": true },
            "check": { "type": "object", "properties": { "basis": { "enum": ["system", "probe", "inference"] } } }
          }
        },
        "else": { "properties": { "done": { "const": false } } }
      },
      {
        "if": { "properties": { "check": { "type": "object", "properties": { "state": { "const": "unknown" } } } } },
        "then": { "properties": { "check": { "type": "object", "properties": { "basis": { "const": "none" } } } } }
      },
      {
        "if": { "properties": { "check": { "type": "object", "properties": { "state": { "const": "failed" } } } } },
        "then": { "properties": { "check": { "type": "object", "properties": { "basis": { "enum": ["system", "probe", "inference"] } } } } }
      }
    ]
  }
}
