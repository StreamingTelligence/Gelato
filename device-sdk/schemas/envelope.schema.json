{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gelato:v1:envelope",
  "title": "Gelato v1 Envelope",
  "type": "object",
  "required": [
    "protocol",
    "type",
    "messageId",
    "sentAt",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "gelato.v1"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{10,80}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^dev_[A-Za-z0-9_-]{10,80}$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^cmd_[A-Za-z0-9_-]{10,80}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{10,80}$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object"
    }
  }
}
