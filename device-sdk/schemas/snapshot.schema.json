{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gelato:v1:snapshot",
  "title": "Gelato v1 device snapshot body",
  "type": "object",
  "required": [
    "revision",
    "kind",
    "displayName",
    "os",
    "driver",
    "hardware",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "os": {
      "type": "object",
      "required": [
        "family",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "driver": {
      "type": "object",
      "required": [
        "id",
        "version",
        "location",
        "state"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "location": {
          "enum": [
            "device",
            "companion",
            "controller-sidecar"
          ]
        },
        "state": {
          "enum": [
            "starting",
            "ready",
            "degraded",
            "unavailable",
            "authorization-required"
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": [
        "present",
        "connected"
      ],
      "additionalProperties": true,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "controlAllowed": {
          "type": "boolean",
          "description": "Persistent local user consent. Missing or false denies all control except device.describe."
        },
        "stableKey": {
          "type": "string",
          "maxLength": 200
        },
        "userAction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          ]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "const": "device.describe" },
          "version": { "const": 1 }
        }
      },
      "items": {
        "$ref": "urn:gelato:v1:capability"
      },
      "uniqueItems": true
    }
  }
}
