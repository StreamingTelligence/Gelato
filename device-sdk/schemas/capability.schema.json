{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gelato:v1:capability",
  "title": "Gelato v1 device capability",
  "type": "object",
  "required": [
    "name",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "limits": {
      "type": "object"
    },
    "consent": {
      "type": "string"
    },
    "requestSchema": {
      "type": "object"
    },
    "resultSchema": {
      "type": "object"
    }
  }
}
