{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gelato:v1:input",
  "title": "Gelato v1 input.publish body",
  "type": "object",
  "required": ["kind", "parts"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["instruction", "observation"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S" }
            }
          },
          {
            "type": "object",
            "required": ["type", "streamId", "mimeType"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "media" },
              "streamId": { "type": "string", "pattern": "^str_[A-Za-z0-9_-]{10,80}$" },
              "mimeType": { "type": "string", "maxLength": 200 }
            }
          }
        ]
      }
    }
  }
}
