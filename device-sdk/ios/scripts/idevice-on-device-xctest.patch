+async fn connect_bound_to_interface(
+    addr: std::net::SocketAddr,
+    interface_index: u32,
+) -> std::io::Result<tokio::net::TcpStream> {
+    if interface_index == 0 || !addr.is_ipv4() {
+        return tokio::net::TcpStream::connect(addr).await;
+    }
+    let socket = tokio::net::TcpSocket::new_v4()?;
+    let index = interface_index as libc::c_uint;
+    let result = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::IPPROTO_IP,
+            libc::IP_BOUND_IF,
+            &index as *const libc::c_uint as *const libc::c_void,
+            std::mem::size_of_val(&index) as libc::socklen_t,
+        )
+    };
+    if result != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    socket.bind(std::net::SocketAddr::from(([10, 7, 0, 0], 0)))?;
+    socket.connect(addr).await
+}
