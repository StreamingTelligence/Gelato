index 0000000..c96eb5e
--- /dev/null
+++ b/ffi/src/xctest_rsd.rs
@@ -0,0 +1,161 @@
+use std::{
+    ffi::{CStr, c_char},
+    path::PathBuf,
+    sync::{Arc, Mutex},
+};
+
+use idevice::{
+    IdeviceError, RsdService,
+    services::{
+        dvt::xctest::{
+            TestConfig, XCUITestService,
+            listener::XCUITestListener,
+        },
+        installation_proxy::InstallationProxyClient,
+    },
+    utils::installation::install_package_rsd,
+};
+
+use crate::{
+    IdeviceFfiError,
+    core_device_proxy::AdapterHandle,
+    ffi_err,
+    rsd::RsdHandshakeHandle,
+    run_sync,
+    run_sync_local,
+};
+
+pub struct XctestWdaRunHandle {
+    task: tokio::task::JoinHandle<()>,
+    error: Arc<Mutex<Option<String>>>,
+}
+
+struct NoopListener;
+impl XCUITestListener for NoopListener {}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_wda_install_rsd(
+    adapter: *mut AdapterHandle,
+    handshake: *mut RsdHandshakeHandle,
+    package_path: *const c_char,
+) -> *mut IdeviceFfiError {
+    if adapter.is_null() || handshake.is_null() || package_path.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let package_path = match unsafe { CStr::from_ptr(package_path) }.to_str() {
+        Ok(value) if !value.is_empty() => PathBuf::from(value),
+        _ => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let result = run_sync_local(async move {
+        let adapter = unsafe { &mut (*adapter).0 };
+        let handshake = unsafe { &mut (*handshake).0 };
+        install_package_rsd(adapter, handshake, package_path, None).await
+    });
+    match result {
+        Ok(()) => std::ptr::null_mut(),
+        Err(error) => ffi_err!(error),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_wda_start_rsd(
+    adapter: *mut AdapterHandle,
+    handshake: *mut RsdHandshakeHandle,
+    runner_bundle_id: *const c_char,
+    ios_major_version: u8,
+    out_handle: *mut *mut XctestWdaRunHandle,
+) -> *mut IdeviceFfiError {
+    if adapter.is_null()
+        || handshake.is_null()
+        || runner_bundle_id.is_null()
+        || out_handle.is_null()
+        || ios_major_version < 17
+    {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let bundle_id = match unsafe { CStr::from_ptr(runner_bundle_id) }.to_str() {
+        Ok(value) if !value.is_empty() => value.to_owned(),
+        _ => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let mut adapter = unsafe { (*adapter).0.clone() };
+    let mut handshake = unsafe { (*handshake).0.clone() };
+    let result = run_sync(async move {
+        let config = {
+            let mut installation_proxy =
+                InstallationProxyClient::connect_rsd(
+                    &mut adapter,
+                    &mut handshake,
+                )
+                .await?;
+            TestConfig::from_installation_proxy(
+                &mut installation_proxy,
+                &bundle_id,
+                None,
+            )
+            .await?
+        };
+        let run_error = Arc::new(Mutex::new(None));
+        let task_error = Arc::clone(&run_error);
+        let task = tokio::spawn(async move {
+            let mut listener = NoopListener;
+            let result = XCUITestService::run_with_existing_rsd(
+                config,
+                ios_major_version,
+                adapter,
+                handshake,
+                &mut listener,
+                None,
+            )
+            .await;
+            let detail = match result {
+                Ok(()) => "XCTest runner exited".to_owned(),
+                Err(error) => format!("XCTest runner failed: {error}"),
+            };
+            if let Ok(mut value) = task_error.lock() {
+                *value = Some(detail);
+            }
+        });
+        Ok::<_, IdeviceError>((task, run_error))
+    });
+    match result {
+        Ok((task, error)) => {
+            unsafe {
+                *out_handle = Box::into_raw(Box::new(
+                    XctestWdaRunHandle { task, error },
+                ));
+            }
+            std::ptr::null_mut()
+        }
+        Err(error) => ffi_err!(error),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_wda_run_error(
+    handle: *mut XctestWdaRunHandle,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    match unsafe { (*handle).error.lock() } {
+        Ok(value) => match value.as_ref() {
+            Some(error) => ffi_err!(IdeviceError::UnknownErrorType(
+                error.clone()
+            )),
+            None => std::ptr::null_mut(),
+        },
+        Err(_) => ffi_err!(IdeviceError::UnknownErrorType(
+            "XCTest runner state lock poisoned".to_owned()
+        )),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_wda_run_free(
+    handle: *mut XctestWdaRunHandle,
+) {
+    if !handle.is_null() {
+        let handle = unsafe { Box::from_raw(handle) };
+        handle.task.abort();
+    }
+}
