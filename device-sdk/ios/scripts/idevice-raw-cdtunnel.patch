+/// Creates an authenticated RemotePairing/CDTunnel and exposes its raw inner
+/// IPv6 packets instead of terminating TCP in jktcp. This lets a Linux peer
+/// attach the tunnel to a kernel TUN interface and own RSD/WDA end-to-end.
+///
+/// # Safety
+/// Pointer arguments must be valid. `packet_callback` must remain callable
+/// until `raw_tunnel_free` returns.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tunnel_create_rppairing_raw(
+    addr: *const idevice_sockaddr,
+    addr_len: idevice_socklen_t,
+    interface_index: u32,
+    hostname: *const c_char,
+    pairing_file: *mut RpPairingFileHandle,
+    pin_callback: Option<extern "C" fn(context: *mut c_void) -> *const c_char>,
+    pin_context: *mut c_void,
+    packet_callback: Option<
+        extern "C" fn(data: *const u8, len: usize, context: *mut c_void),
+    >,
+    packet_context: *mut c_void,
+    out_handle: *mut *mut RawTunnelHandle,
+) -> *mut IdeviceFfiError {
+    if addr.is_null()
+        || hostname.is_null()
+        || pairing_file.is_null()
+        || packet_callback.is_none()
+        || out_handle.is_null()
+    {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let socket_addr = match crate::util::c_socket_to_rust(addr as *const SockAddr, addr_len) {
+        Ok(value) => value,
+        Err(error) => return ffi_err!(error),
+    };
+    let host = match unsafe { CStr::from_ptr(hostname) }.to_str() {
+        Ok(value) => value.to_owned(),
+        Err(_) => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let rpf = unsafe { &mut (*pairing_file).0 };
+    let pin_context = PinCtx(pin_context);
+    let callback = packet_callback.expect("validated above");
+    let callback_context = packet_context as usize;
+
+    let result = run_sync_local(async {
+        use idevice::remote_pairing::connect_tls_psk_tunnel;
+
+        let stream = run_global_timeout(|| {
+            connect_bound_to_interface(socket_addr, interface_index)
+        })
+        .await
+        .map_err(|error| IdeviceError::InternalError(format!("connect: {error}")))?;
+        let conn = RpPairingSocket::new(stream);
+        let mut rpc = RemotePairingClient::new(conn, &host);
+        rpc.connect(rpf, async || get_pin(pin_callback, &pin_context))
+            .await?;
+
+        let tunnel_port = rpc.create_tcp_listener().await?;
+        let mut tunnel_addr = socket_addr;
+        tunnel_addr.set_port(tunnel_port);
+        let tunnel_stream = run_global_timeout(|| {
+            connect_bound_to_interface(tunnel_addr, interface_index)
+        })
+        .await
+        .map_err(|error| IdeviceError::InternalError(format!("TLS tunnel: {error}")))?;
+        let tunnel = run_global_timeout(|| {
+            connect_tls_psk_tunnel(tunnel_stream, rpc.encryption_key())
+        })
+        .await
+        .map_err(|error| {
+            IdeviceError::InternalError(format!("TLS-PSK handshake: {error}"))
+        })?;
+
+        let client_address = tunnel.info.client_address.clone();
+        let server_address = tunnel.info.server_address.clone();
+        let mtu = tunnel.info.mtu;
+        let rsd_port = tunnel.info.server_rsd_port;
+        let (mut reader, mut writer) = tokio::io::split(tunnel.into_inner());
+        let (sender, mut receiver) = tokio::sync::mpsc::unbounded_channel::<Vec<u8>>();
+        let read_task = tokio::spawn(async move {
+            loop {
+                let mut header = [0u8; 40];
+                if reader.read_exact(&mut header).await.is_err() {
+                    break;
+                }
+                if header[0] >> 4 != 6 {
+                    break;
+                }
+                let payload_len = u16::from_be_bytes([header[4], header[5]]) as usize;
+                let mut packet = Vec::with_capacity(40 + payload_len);
+                packet.extend_from_slice(&header);
+                packet.resize(40 + payload_len, 0);
+                if reader.read_exact(&mut packet[40..]).await.is_err() {
+                    break;
+                }
+                callback(
+                    packet.as_ptr(),
+                    packet.len(),
+                    callback_context as *mut c_void,
+                );
+            }
+        });
+        let write_task = tokio::spawn(async move {
+            while let Some(packet) = receiver.recv().await {
+                if writer.write_all(&packet).await.is_err()
+                    || writer.flush().await.is_err()
+                {
+                    break;
+                }
+            }
+        });
+
+        Ok::<_, IdeviceError>(RawTunnelHandle {
+            sender,
+            read_task,
+            write_task,
+            client_address,
+            server_address,
+            mtu,
+            rsd_port,
+        })
+    });
+
+    match result {
+        Ok(handle) => {
+            unsafe {
+                *out_handle = Box::into_raw(Box::new(handle));
+            }
+            null_mut()
+        }
+        Err(error) => ffi_err!(error),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn raw_tunnel_send_packet(
+    handle: *mut RawTunnelHandle,
+    data: *const u8,
+    len: usize,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || data.is_null() || !(40..=65535).contains(&len) {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let packet = unsafe { std::slice::from_raw_parts(data, len) };
+    if packet[0] >> 4 != 6 {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    match unsafe { &*handle }.sender.send(packet.to_vec()) {
+        Ok(()) => null_mut(),
+        Err(_) => ffi_err!(IdeviceError::InternalError(
+            "raw tunnel writer is closed".to_owned()
+        )),
+    }
+}
+
+unsafe fn copy_string_to_buffer(value: &str, buffer: *mut c_char, capacity: usize) -> bool {
+    if buffer.is_null() || capacity <= value.len() {
+        return false;
+    }
+    unsafe {
+        std::ptr::copy_nonoverlapping(value.as_ptr(), buffer.cast::<u8>(), value.len());
+        *buffer.add(value.len()) = 0;
+    }
+    true
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn raw_tunnel_get_info(
+    handle: *mut RawTunnelHandle,
+    client_address: *mut c_char,
+    client_address_capacity: usize,
+    server_address: *mut c_char,
+    server_address_capacity: usize,
+    out_mtu: *mut u16,
+    out_rsd_port: *mut u16,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || out_mtu.is_null() || out_rsd_port.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let handle = unsafe { &*handle };
+    if !unsafe {
+        copy_string_to_buffer(
+            &handle.client_address,
+            client_address,
+            client_address_capacity,
+        )
+    } || !unsafe {
+        copy_string_to_buffer(
+            &handle.server_address,
+            server_address,
+            server_address_capacity,
+        )
+    } {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    unsafe {
+        *out_mtu = handle.mtu;
+        *out_rsd_port = handle.rsd_port;
+    }
+    null_mut()
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn raw_tunnel_free(handle: *mut RawTunnelHandle) {
+    if handle.is_null() {
+        return;
+    }
+    let handle = unsafe { Box::from_raw(handle) };
+    run_sync_local(async move {
+        handle.read_task.abort();
+        handle.write_task.abort();
+        let _ = handle.read_task.await;
+        let _ = handle.write_task.await;
+    });
+}
