+type encryptedAutomationSession struct {
+	AccountHash string  `json:"account_hash"`
+	Session     session `json:"session"`
+}
+
+func automationAccountHash(username string) string {
+	digest := sha256.Sum256([]byte(strings.ToLower(strings.TrimSpace(username))))
+	return hex.EncodeToString(digest[:])
+}
+
+func (dp *DevPortal) automationSessionPath() string {
+	return filepath.Join(dp.config.ConfigDir, automationSessionFilename)
+}
+
+func (dp *DevPortal) prepareAutomationSessionDirectory() error {
+	if err := os.MkdirAll(dp.config.ConfigDir, 0700); err != nil {
+		return fmt.Errorf("failed to create automation session directory: %v", err)
+	}
+	if err := os.Chmod(dp.config.ConfigDir, 0700); err != nil {
+		return fmt.Errorf("failed to secure automation session directory: %v", err)
+	}
+	return nil
+}
+
+func encryptAutomationSession(password string, plaintext []byte) ([]byte, error) {
+	salt := make([]byte, 16)
+	if _, err := io.ReadFull(rand.Reader, salt); err != nil {
+		return nil, err
+	}
+	key, err := scrypt.Key([]byte(password), salt, 32768, 8, 1, 32)
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	var aead cipher.AEAD
+	aead, err = cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	nonce := make([]byte, aead.NonceSize())
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return nil, err
+	}
+	sealed := append([]byte("IPSWSES1"), salt...)
+	sealed = append(sealed, nonce...)
+	return aead.Seal(sealed, nonce, plaintext, nil), nil
+}
+
+func decryptAutomationSession(password string, sealed []byte) ([]byte, error) {
+	if len(sealed) < 24 || string(sealed[:8]) != "IPSWSES1" {
+		return nil, fmt.Errorf("encrypted automation session has an invalid header")
+	}
+	salt := sealed[8:24]
+	key, err := scrypt.Key([]byte(password), salt, 32768, 8, 1, 32)
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	if len(sealed) < 24+aead.NonceSize() {
+		return nil, fmt.Errorf("encrypted automation session is truncated")
+	}
+	nonce := sealed[24 : 24+aead.NonceSize()]
+	ciphertext := sealed[24+aead.NonceSize():]
+	return aead.Open(nil, nonce, ciphertext, nil)
+}
+
+func (dp *DevPortal) storeAutomationSession(username, password string) error {
+	if err := dp.prepareAutomationSessionDirectory(); err != nil {
+		return err
+	}
+	payload, err := json.Marshal(encryptedAutomationSession{
+		AccountHash: automationAccountHash(username),
+		Session: session{
+			SessionID: dp.GetSessionID(),
+			SCNT:      dp.GetSCNT(),
+			WidgetKey: dp.GetWidgetKey(),
+			HashCash:  dp.GetHashcash(),
+			Cookies:   dp.Client.Jar.Cookies(&url.URL{Scheme: "https", Host: "idmsa.apple.com"}),
+		},
+	})
+	if err != nil {
+		return fmt.Errorf("failed to encode automation session: %v", err)
+	}
+	sealed, err := encryptAutomationSession(password, payload)
+	if err != nil {
+		return fmt.Errorf("failed to encrypt automation session: %v", err)
+	}
+	sessionPath := dp.automationSessionPath()
+	temporary, err := os.CreateTemp(dp.config.ConfigDir, ".automation-session-*")
+	if err != nil {
+		return fmt.Errorf("failed to create temporary automation session: %v", err)
+	}
+	temporaryPath := temporary.Name()
+	defer os.Remove(temporaryPath)
+	if err := temporary.Chmod(0600); err != nil {
+		temporary.Close()
+		return fmt.Errorf("failed to secure temporary automation session: %v", err)
+	}
+	if _, err := temporary.Write(sealed); err != nil {
+		temporary.Close()
+		return fmt.Errorf("failed to write automation session: %v", err)
+	}
+	if err := temporary.Sync(); err != nil {
+		temporary.Close()
+		return fmt.Errorf("failed to sync automation session: %v", err)
+	}
+	if err := temporary.Close(); err != nil {
+		return fmt.Errorf("failed to close automation session: %v", err)
+	}
+	if err := os.Rename(temporaryPath, sessionPath); err != nil {
+		return fmt.Errorf("failed to install automation session: %v", err)
+	}
+	return nil
+}
+
+func (dp *DevPortal) readAutomationSession(username, password string) (session, error) {
+	var result session
+	if err := dp.prepareAutomationSessionDirectory(); err != nil {
+		return result, err
+	}
+	sessionPath := dp.automationSessionPath()
+	info, err := os.Stat(sessionPath)
+	if err != nil || info.Mode().Perm() != 0600 {
+		return result, fmt.Errorf("automation session is missing or insecure")
+	}
+	sealed, err := os.ReadFile(sessionPath)
+	if err != nil {
+		return result, fmt.Errorf("failed to read automation session: %v", err)
+	}
+	plaintext, err := decryptAutomationSession(password, sealed)
+	if err != nil {
+		return result, fmt.Errorf("failed to decrypt automation session: %v", err)
+	}
+	var saved encryptedAutomationSession
+	if err := json.Unmarshal(plaintext, &saved); err != nil {
+		return result, fmt.Errorf("failed to decode automation session: %v", err)
+	}
+	expected := []byte(automationAccountHash(username))
+	actual := []byte(saved.AccountHash)
+	if len(expected) != len(actual) || subtle.ConstantTimeCompare(expected, actual) != 1 {
+		return result, fmt.Errorf("automation session belongs to another Apple ID")
+	}
+	if saved.Session.SessionID == "" || saved.Session.WidgetKey == "" || len(saved.Session.Cookies) == 0 {
+		return result, fmt.Errorf("automation session is incomplete")
+	}
+	return saved.Session, nil
+}
+
+func (dp *DevPortal) loadAutomationSession(username, password string) error {
+	saved, err := dp.readAutomationSession(username, password)
+	if err != nil {
+		return err
+	}
+	dp.config.SessionID = saved.SessionID
+	dp.config.SCNT = saved.SCNT
+	dp.config.WidgetKey = saved.WidgetKey
+	dp.config.HashCash = saved.HashCash
+	dp.Client.Jar.SetCookies(&url.URL{Scheme: "https", Host: "idmsa.apple.com"}, saved.Cookies)
+	if err := dp.getOlympusSession(); err != nil {
+		_ = os.Remove(dp.automationSessionPath())
+		return err
+	}
+	return nil
+}
