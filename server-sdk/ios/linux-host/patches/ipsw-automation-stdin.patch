+// DownloadLatestMatchingMore downloads the newest More Downloads file whose
+// product name, display name, or filename matches pattern.
+func (dp *DevPortal) DownloadLatestMatchingMore(pattern, folder string) error {
+	matcher, err := regexp.Compile(pattern)
+	if err != nil {
+		return fmt.Errorf("invalid latest-match regular expression: %v", err)
+	}
+	downloads, err := dp.getDownloads()
+	if err != nil {
+		return fmt.Errorf("failed to get More Downloads: %v", err)
+	}
+	for _, product := range downloads.Downloads {
+		for _, file := range product.Files {
+			searchableName := strings.Join(
+				[]string{product.Name, file.DisplayName, file.Filename},
+				" ",
+			)
+			if !matcher.MatchString(searchableName) {
+				continue
+			}
+			destination := filepath.Join(
+				filepath.Clean(folder),
+				filepath.Base(getDestName(file.URL(), dp.config.RemoveCommas)),
+			)
+			if info, err := os.Stat(destination); err == nil &&
+				file.FileSize > 0 && info.Size() != int64(file.FileSize) {
+				if err := os.Remove(destination); err != nil {
+					return fmt.Errorf("failed to remove incomplete matching download: %v", err)
+				}
+			}
+			if err := json.NewEncoder(os.Stdout).Encode(map[string]any{
+				"event":       "selected_download",
+				"product":     product.Name,
+				"file":        file.DisplayName,
+				"size":        file.FileSize,
+				"destination": filepath.Base(destination),
+			}); err != nil {
+				return fmt.Errorf("failed to write selected-download event: %v", err)
+			}
+			if err := dp.Download(file.URL(), folder); err != nil {
+				return err
+			}
+			info, err := os.Stat(destination)
+			if err != nil || (file.FileSize > 0 && info.Size() != int64(file.FileSize)) {
+				return fmt.Errorf("matching download did not complete at the expected size")
+			}
+			return nil
+		}
+	}
+	return fmt.Errorf("no More Downloads file matched the requested regular expression")
+}
