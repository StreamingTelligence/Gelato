+func (dp *DevPortal) readAutomationResponse(event map[string]any, destination any) error {
+	if dp.config.AutomationInput == nil {
+		return fmt.Errorf("automation input is not configured")
+	}
+	if err := json.NewEncoder(os.Stdout).Encode(event); err != nil {
+		return fmt.Errorf("failed to write automation event: %v", err)
+	}
+	line, err := dp.config.AutomationInput.ReadBytes('\n')
+	if err != nil {
+		return fmt.Errorf("failed to read automation response")
+	}
+	if err := json.Unmarshal(line, destination); err != nil {
+		return fmt.Errorf("invalid automation response")
+	}
+	return nil
+}
