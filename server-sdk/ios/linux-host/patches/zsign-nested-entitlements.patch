+static string NormalizeBundlePath(string path)
+{
+    replace(path.begin(), path.end(), '\\', '/');
+    while (path.size() > 1 && path.back() == '/') {
+        path.pop_back();
+    }
+    return path;
+}
+
+void ZBundle::SetEntitlementMapping(const map<string, string>& entitlementMapping)
+{
+    m_entitlementMapping.clear();
+    for (const auto& entry : entitlementMapping) {
+        m_entitlementMapping[NormalizeBundlePath(entry.first)] = entry.second;
+    }
+}
+
+void ZBundle::UseEntitlementsForFolder(const string& strFolder)
+{
+    const auto found = m_entitlementMapping.find(NormalizeBundlePath(strFolder));
+    m_pSignAsset->m_strEntitleData = found == m_entitlementMapping.end()
+        ? m_strDefaultEntitlements
+        : found->second;
+}
