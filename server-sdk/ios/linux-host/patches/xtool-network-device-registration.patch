+struct DSDevicesAddCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "add",
+        abstract: "Register a network-enrolled iOS device"
+    )
+
+    @Option(help: "Device UDID obtained through network enrollment")
+    var udid: String
+
+    @Option(help: "Display name for the registered device")
+    var name: String
+
+    func run() async throws {
+        let client = DeveloperAPIClient(auth: try AuthToken.saved().authData())
+        let response = try await client.devicesCreateInstance(
+            body: .json(.init(data: .init(
+                _type: .devices,
+                attributes: .init(
+                    name: name,
+                    platform: .init(.ios),
+                    udid: udid
+                )
+            )))
+        )
+
+        if (try? response.conflict) != nil {
+            print("Device is already registered")
+            return
+        }
+
+        _ = try response.created
+        print("Device registered")
+    }
+}
